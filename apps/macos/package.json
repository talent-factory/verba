{
  "name": "@verba/macos",
  "version": "0.0.0",
  "description": "Verba for macOS — system-wide dictation menu-bar app (Tauri)",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "pretest:unit": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('dist-test/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "test:unit": "mocha"
  },
  "dependencies": {
    "@verba/core": "*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0"
  }
}
