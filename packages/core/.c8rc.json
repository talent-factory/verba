{
  "all": true,
  "include": ["dist/**/*.js"],
  "exclude": [
    "dist/test/**",
    "dist/**/*.test.js",
    "dist/index.js",
    "dist/adapters.js"
  ],
  "reporter": ["text-summary", "text", "lcov"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "lines": 90,
  "statements": 90,
  "functions": 90,
  "branches": 85
}
